.spawn-debug-panel {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 280px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(0, 0, 0, 0.75);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    color: white;
}

.spawn-debug-title {
    color: white;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.spawn-debug-hint {
    color: white;
    font-size: 11px;
    margin-bottom: 6px;
}

.spawn-debug-field {
    margin-bottom: 8px;
}

.spawn-debug-field .unity-base-field__label {
    color: white;
}

.spawn-debug-field .unity-base-text-field__input {
    color: white;
    background-color: rgb(31, 31, 31);
    border-top-color: rgb(77, 77, 77);
    border-right-color: rgb(77, 77, 77);
    border-bottom-color: rgb(77, 77, 77);
    border-left-color: rgb(77, 77, 77);
}

.spawn-debug-button {
    margin-bottom: 6px;
}

.spawn-debug-status {
    color: white;
    font-size: 11px;
    white-space: normal;
}
